# Copy to .env for local development. Never commit real values.
# Production refuses empty/placeholder values and mock adapters (packages/config).
APP_ENV=development
# mock | sandbox | production (defaults: development/test -> mock, staging -> sandbox, production -> production)
PROVIDER_ENV=mock
ALLOW_MOCK_ADAPTERS=true
DATABASE_URL=postgres://texholiday:texholiday_local_dev@127.0.0.1:5432/texholiday_dev
REDIS_URL=redis://127.0.0.1:6379/0
PAYLOAD_ENABLED=false
PAYLOAD_SECRET=
# Comma separated: iyzico,nuitee,welcome_pickups
ENABLED_PROVIDERS=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Merchant-contract dependent; REFUSE until verified (never a fabricated Turkish id)
IYZICO_FOREIGN_IDENTITY_POLICY=REFUSE
NUITEE_API_KEY=
NUITEE_KEY_ENVIRONMENT=
WELCOME_API_KEY=
SERVER_EGRESS_IP=
# Business-edited policy set (G06) used by this deployment
POLICY_ID=b2c
# Opt-in Nuitee sandbox evidence run (pnpm test:sandbox); NUITEE_SANDBOX_BOOK=1 also books with the sandbox test card
NUITEE_SANDBOX_BOOK=
# Integration tests (disposable databases only)
TEST_DATABASE_URL=postgres://texholiday:texholiday_local_dev@127.0.0.1:5432/texholiday_test
TEST_REDIS_URL=redis://127.0.0.1:6379/15
