# Copy to .env for local development. Never commit real values.
# Production refuses empty/placeholder values and mock adapters (packages/config).
APP_ENV=development
# mock | sandbox | production (defaults: development/test -> mock, staging -> sandbox, production -> production)
PROVIDER_ENV=mock
ALLOW_MOCK_ADAPTERS=true
DATABASE_URL=postgres://texholiday:texholiday_local_dev@127.0.0.1:5432/texholiday_dev
REDIS_URL=redis://127.0.0.1:6379/0
PAYLOAD_ENABLED=false
PAYLOAD_SECRET=
# Comma separated: iyzico,nuitee,welcome_pickups
ENABLED_PROVIDERS=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Merchant-contract dependent; REFUSE until verified (never a fabricated Turkish id)
IYZICO_FOREIGN_IDENTITY_POLICY=REFUSE
NUITEE_API_KEY=
NUITEE_KEY_ENVIRONMENT=
WELCOME_API_KEY=
SERVER_EGRESS_IP=
# Business-edited policy set (G06) used by this deployment
POLICY_ID=b2c
# Opt-in Nuitee sandbox evidence run (pnpm test:sandbox); NUITEE_SANDBOX_BOOK=1 also books with the sandbox test card
NUITEE_SANDBOX_BOOK=
# Margin in basis points for the sandbox run (ADR-0006: own-gateway hotels use the provider API margin; 0/empty = net rate)
NUITEE_SANDBOX_MARGIN_BP=
# Integration tests (disposable databases only)
TEST_DATABASE_URL=postgres://texholiday:texholiday_local_dev@127.0.0.1:5432/texholiday_test
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# Web / booking application (ADR-0008)
# HMAC secret for guest order access tokens (httpOnly cookie); at least 32 random characters, never shared.
ORDER_ACCESS_SECRET=
# Version id of the published sales terms the customer accepts (legal content, CMS later).
TERMS_VERSION=
# Absolute public origin for provider return URLs (e.g. https://www.texholiday.com); defaults to the request host.
PUBLIC_BASE_URL=
# Currencies offered to customers; routes still decide what is actually payable (TRY needs our own gateway).
SALE_CURRENCIES=EUR,USD,GBP,TRY
# Technical timings (seconds): search result validity, quote hold, provider payment deadline.
SEARCH_TTL_SECONDS=1800
QUOTE_TTL_SECONDS=1200
PAY_BY_SECONDS=1800

# Staff panel /yonetim (ADR-0010). 32 random bytes in base64 (`openssl rand -base64 32`); keep a backup in the secret
# manager: without it nobody can pass MFA (everyone must re-enroll).
STAFF_MFA_KEY=
# Optional security settings (defaults: 30 min idle, 12 h max, 5 failures -> 15 min lock, 72 h setup links, 12 chars)
STAFF_SESSION_IDLE_MINUTES=
STAFF_SESSION_MAX_HOURS=
STAFF_LOCKOUT_ATTEMPTS=
STAFF_LOCKOUT_MINUTES=
STAFF_SETUP_LINK_HOURS=
STAFF_MIN_PASSWORD_LENGTH=
# Sign-in steps per client IP in 5 minutes (default 30; offices often share one public IP)
STAFF_IP_ATTEMPTS_PER_5_MIN=

# Opt-in Nuitee sandbox browser tests (pnpm web:e2e:sandbox; needs NUITEE_API_KEY + NUITEE_KEY_ENVIRONMENT=sandbox).
# Currencies paid in the connector-level test, and offered by the sandbox site run.
SANDBOX_PAYMENT_CURRENCIES=EUR,USD,GBP
SANDBOX_SITE_CURRENCIES=EUR
# JSON-lines evidence output (ids/statuses only)
SANDBOX_EVIDENCE_FILE=
# Sandbox suggested selling prices are synthetic (always above the price); true is refused unless PROVIDER_ENV=sandbox.
SANDBOX_SKIP_RATE_PARITY=
