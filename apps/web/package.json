{
  "name": "@texholiday/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Customer site, HTTP API, /yonetim staff panel and Payload CMS (Next.js).",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "e2e:sandbox": "NODE_USE_ENV_PROXY=1 playwright test -c playwright.sandbox.config.ts",
    "cms:migrate": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload migrate",
    "cms:migrate:create": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload migrate:create",
    "cms:importmap": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:importmap",
    "cms:redirects:import": "tsx src/scripts/import-redirects.ts"
  },
  "dependencies": {
    "@faceless-ui/modal": "3.0.0",
    "@faceless-ui/scroll-info": "2.0.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@texholiday/admin": "workspace:*",
    "@texholiday/booking": "workspace:*",
    "@texholiday/config": "workspace:*",
    "@texholiday/connectors": "workspace:*",
    "@texholiday/contracts": "workspace:*",
    "@texholiday/db": "workspace:*",
    "@texholiday/pricing": "workspace:*",
    "graphql": "16.14.2",
    "next": "16.3.8",
    "payload": "3.90.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "pg": "8.20.0",
    "tsx": "4.20.6"
  }
}
